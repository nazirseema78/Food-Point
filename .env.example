# ============================================================
#  Food-Point — environment variables template
#  TEMPLATE: safe to commit. Contains no real secrets.
#  Replace every value in <angle brackets>, then save.
# ============================================================

# ---------- Database (Neon PostgreSQL) ----------
# Neon dashboard -> your project -> "Connect".
# DATABASE_URL = the *pooled* connection string (host contains "-pooler").
# DIRECT_URL   = the *direct* connection string (same, without "-pooler"); used for migrations.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# ---------- Auth (login sessions) ----------
# Random secret, 32+ characters. Generate one in the terminal with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<paste-generated-secret-here>"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Cloudinary (product images) ----------
# Cloudinary dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME="<your-cloud-name>"
CLOUDINARY_API_KEY="<your-api-key>"
CLOUDINARY_API_SECRET="<your-api-secret>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<your-cloud-name>"
CLOUDINARY_UPLOAD_FOLDER="food-point"

# ---------- First admin account (created by `npm run db:seed`) ----------
ADMIN_NAME="<Your Name>"
ADMIN_EMAIL="<you@example.com>"
ADMIN_PASSWORD="<choose-a-strong-password>"
